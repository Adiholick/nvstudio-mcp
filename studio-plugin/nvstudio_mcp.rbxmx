		<Item class="ModuleScript" referent="RBX_scan_security">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">scan_security</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ============================================================================
-- Skill Module: scan_security
-- Deskripsi: Audit Keamanan Instance/Model yang Sudah Ada di Tempat Kerja Studio
-- ============================================================================

local HttpService = game:GetService("HttpService")
local SecurityScanner = require(script.Parent:WaitForChild("security_scanner"))

return function(targetInstance: Instance?, data: any, ctx: any, targetPath: string?)
    local target = targetInstance or game.Workspace
    local deepScan = true
    local cleanThreats = false

    if typeof(data) == "string" and #data > 0 then
        local success, parsed = pcall(function()
            return HttpService:JSONDecode(data)
        end)
        if success and typeof(parsed) == "table" then
            if parsed.deep_scan ~= nil then deepScan = parsed.deep_scan end
            if parsed.clean_threats ~= nil then cleanThreats = parsed.clean_threats end
        end
    elseif typeof(data) == "table" then
        if data.deep_scan ~= nil then deepScan = data.deep_scan end
        if data.clean_threats ~= nil then cleanThreats = data.clean_threats end
    end

    local scanResult
    local ok, err = pcall(function()
        scanResult = SecurityScanner.scanInstance(target, deepScan)
    end)

    if not ok or not scanResult then
        return {
            status = "error",
            error = "Gagal memindai target: " .. tostring(err)
        }
    end

    local cleanedScripts = {}
    if cleanThreats and #scanResult.threats > 0 then
        -- Hapus skrip yang terdeteksi bahaya (HIGH severity)
        local scriptsToDestroy = {}
        for _, threat in ipairs(scanResult.threats) do
            if threat.severity == "HIGH" and threat.scriptPath then
                scriptsToDestroy[threat.scriptPath] = true
            end
        end

        local function purge(instance: Instance)
            for _, desc in ipairs(instance:GetDescendants()) do
                if desc:IsA("LuaSourceContainer") and scriptsToDestroy[desc:GetFullName()] then
                    table.insert(cleanedScripts, {
                        name = desc.Name,
                        className = desc.ClassName,
                        path = desc:GetFullName(),
                    })
                    pcall(function() desc:Destroy() end)
                end
            end
        end

        purge(target)
    end

    return {
        status = "success",
        result = {
            target = target:GetFullName(),
            riskLevel = scanResult.riskLevel,
            stats = scanResult.stats,
            highThreatsCount = scanResult.highThreats,
            mediumThreatsCount = scanResult.mediumThreats,
            threats = scanResult.threats,
            cleanedThreatsCount = #cleanedScripts,
            cleanedScripts = cleanedScripts,
            isCleaned = cleanThreats,
        }
    }
end

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_script_grep">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">script_grep</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[return function(targetInstance, data, ctx, targetPath)
    if not data or data == "" or data == "nil" then
        return { status = "error", error = "Query pencarian tidak boleh kosong." }
    end
    local query = tostring(data)

    local matches = {}
    local matchCount = 0
    local MAX_MATCHES = 50

    local searchableServices = {
        game:GetService("Workspace"),
        game:GetService("ServerScriptService"),
        game:GetService("ReplicatedStorage"),
        game:GetService("StarterPlayer"),
        game:GetService("StarterGui"),
        game:GetService("ServerStorage"),
        game:GetService("Lighting")
    }

    local function searchInScript(scriptObj)
        local success, source = pcall(function() return scriptObj.Source end)
        if not success or not source then return end

        local lines = string.split(source, "\n")
        for i, line in ipairs(lines) do
            -- Coba cari dengan plain text dulu, jika gagal coba pattern
            local found = string.find(line, query, 1, true)
            if not found then
                pcall(function() found = string.find(line, query) end)
            end

            if found then
                table.insert(matches, {
                    script = scriptObj:GetFullName(),
                    line = i,
                    content = string.match(line, "^%s*(.-)%s*$") or line
                })
                matchCount = matchCount + 1
                if matchCount >= MAX_MATCHES then
                    return true
                end
            end
        end
        return false
    end

    if targetInstance and targetInstance ~= game then
        local descendants = {}
        pcall(function() descendants = targetInstance:GetDescendants() end)
        for i, desc in ipairs(descendants) do
            if i % 300 == 0 then task.wait() end
            if matchCount >= MAX_MATCHES then break end
            if desc:IsA("LuaSourceContainer") then
                if searchInScript(desc) then
                    break
                end
            end
        end
    else
        for _, service in ipairs(searchableServices) do
            local descendants = {}
            pcall(function() descendants = service:GetDescendants() end)
            for i, desc in ipairs(descendants) do
                if i % 300 == 0 then task.wait() end
                if matchCount >= MAX_MATCHES then break end
                if desc:IsA("LuaSourceContainer") then
                    if searchInScript(desc) then
                        break
                    end
                end
            end
            if matchCount >= MAX_MATCHES then
                break
            end
        end
    end

    return { status = "success", matches = matches, count = matchCount, limitReached = (matchCount >= MAX_MATCHES) }
end
]]></ProtectedString>
			</Properties>
