		<Item class="ModuleScript" referent="RBX_insert_asset">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">insert_asset</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ============================================================================
-- Skill Module: insert_asset (Upgraded with Asset Security Scanner & Script Stripper)
-- ============================================================================

local HttpService = game:GetService("HttpService")
local InsertService = game:GetService("InsertService")

local SecurityScanner = require(script.Parent:WaitForChild("security_scanner"))

return function(targetInstance: Instance?, data: any, ctx: any, targetPath: string?)
    local assetIdStr = ""
    local stripScripts = true  -- Default TRUE demi keamanan mutlak
    local scanSecurity = true

    if typeof(data) == "string" then
        local success, parsed = pcall(function()
            return HttpService:JSONDecode(data)
        end)
        if success and typeof(parsed) == "table" then
            assetIdStr = tostring(parsed.asset_id or parsed.assetId or "")
            if parsed.strip_scripts ~= nil then stripScripts = parsed.strip_scripts end
            if parsed.scan_security ~= nil then scanSecurity = parsed.scan_security end
        else
            assetIdStr = data
        end
    elseif typeof(data) == "table" then
        assetIdStr = tostring(data.asset_id or data.assetId or "")
        if data.strip_scripts ~= nil then stripScripts = data.strip_scripts end
        if data.scan_security ~= nil then scanSecurity = data.scan_security end
    end

    local rawId = string.gsub(assetIdStr, "rbxassetid://", "")
    rawId = string.gsub(rawId, "%s+", "")
    local assetId = tonumber(rawId)

    if not assetId or assetId <= 0 then
        return { status = "error", error = "Asset ID harus berupa angka yang valid." }
    end

    local success, model = pcall(function()
        return InsertService:LoadAsset(assetId)
    end)

    if not success or not model then
        return {
            status = "error",
            error = "Gagal memuat aset. Pastikan Asset ID benar dan model berstatus publik di Creator Store."
        }
    end

    local securityNotes = {}
    local removedScripts = {}

    -- 1. Scan keamanan jika diaktifkan
    if scanSecurity then
        local scanResult = SecurityScanner.scanInstance(model, true)
        if scanResult.riskLevel == "DANGEROUS" then
            table.insert(securityNotes, string.format("⚠️ PERINGATAN: Aset ini memiliki %d ancaman BERBAHAYA (Backdoor/Obfuscation/Webhook)!", scanResult.highThreats))
        end
    end

    -- 2. Sanitasi: Hapus skrip jika strip_scripts = true
    if stripScripts then
        removedScripts = SecurityScanner.stripScripts(model)
        if #removedScripts > 0 then
            table.insert(securityNotes, string.format("🛡️ Keamanan: %d skrip bawaan telah dihapus secara otomatis demi keamanan game Anda.", #removedScripts))
        else
            table.insert(securityNotes, "🛡️ Keamanan: Aset bersih, tidak ditemukan skrip berbahaya.")
        end
    else
        table.insert(securityNotes, "ℹ️ Catatan: strip_scripts = false, skrip bawaan model dipertahankan.")
    end

    -- 3. Masukkan model ke target
    local parentTarget = targetInstance
    if not parentTarget or parentTarget == game or parentTarget.ClassName == "DataModel" then
        parentTarget = game.Workspace
    end

    model.Parent = parentTarget

    return {
        status = "success",
        result = {
            message = string.format("Aset '%s' (ID: %d) berhasil dimasukkan ke %s.", model.Name, assetId, parentTarget.Name),
            assetName = model.Name,
            assetId = assetId,
            parent = parentTarget:GetFullName(),
            stripScriptsApplied = stripScripts,
            removedScriptsCount = #removedScripts,
            removedScripts = removedScripts,
            securityNotes = table.concat(securityNotes, "\n"),
        }
    }
end
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_Main">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Main</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<token name="RunContext">0</token>
				<ProtectedString name="Source"><![CDATA[-- ══════════════════════════════════════════════════════════════════════
-- NVStudio MCP Plugin v2.4.3
-- Arsitektur: Dual-Mode WebSocket Duplex (Port 3055/ws) + Fallback Long-Polling
-- Plugin auto-connect saat dimuat via WebSocket native, dengan fallback otomatis
-- ke HTTP stream jika WebSocket tidak tersedia di environment Roblox Studio ini.
-- ══════════════════════════════════════════════════════════════════════

local HttpService    = game:GetService("HttpService")
local LogService     = game:GetService("LogService")

-- URL Endpoints
local BASE_URL       = "http://localhost:3055"
local STREAM_URL     = BASE_URL .. "/api/stream"      -- SSE long-poll (blocking GET)
local RESPONSE_URL   = BASE_URL .. "/api/response"
local PING_URL       = BASE_URL .. "/api/ping"
local WS_URL         = "ws://localhost:3055/ws"
local WS_URL_IP      = "ws://127.0.0.1:3055/ws"

-- ID unik per sesi Studio
local STUDIO_ID      = HttpService:GenerateGUID(false)

-- ── UI Module ──────────────────────────────────────────────────────────────────
local uiModule = script.Parent:FindFirstChild("ui_manager")
local ui = nil

-- ── Toolbar ───────────────────────────────────────────────────────────────────
local toolbar   = plugin:CreateToolbar("NVStudio MCP")
local toggleBtn = toolbar:CreateButton("Dashboard", "Buka Dashboard NVStudio MCP", "rbxassetid://82696893597722", "NVStudio")

-- ── State ─────────────────────────────────────────────────────────────────────
local ctx = {
	scriptHistory = {},
	recentLogs    = {},
	HttpService   = HttpService,
	studioId      = STUDIO_ID,
	getInstanceFromPath = nil -- akan di-bind di bawah
}
local MAX_LOGS           = 50
local isRunning          = false  -- apakah loop/koneksi aktif
local isManualDisconnect = false
local isClickDebounce    = false
local mcpAgentActive     = false  -- apakah Antigravity sedang konek ke MCP
local serverReachable    = false  -- apakah server Node.js reachable
local activeWsWrapper    = nil
local currentTransport   = "none" -- "websocket" | "longpoll" | "none"

-- Reconnect config untuk Long-Polling
local RECONNECT_DELAY_INITIAL = 1.5
local RECONNECT_DELAY_MAX     = 1.5
local reconnectDelay          = RECONNECT_DELAY_INITIAL
local currentLoopId           = nil

-- Task deduplication state (Bug G)
local runningTasks   = {} -- taskId -> true
local completedTasks = {} -- taskId -> os.clock()

local function shouldProcessTask(taskId)
	if not taskId or taskId == "" then return false end
	if runningTasks[taskId] then
		return false
	end
	local completedAt = completedTasks[taskId]
	if completedAt and (os.clock() - completedAt < 60) then
		return false
	end
	runningTasks[taskId] = true
	return true
end

local function markTaskDone(taskId)
	if not taskId then return end
	runningTasks[taskId] = nil
	completedTasks[taskId] = os.clock()

	-- Bersihkan entri kedaluwarsa (>60 detik)
	local now = os.clock()
	for id, t in pairs(completedTasks) do
		if now - t > 60 then
			completedTasks[id] = nil
		end
	end
end

-- Forward declaration
local startConnectionManager = nil
local startLongPollingLoop   = nil

-- ── Skills (ModuleScript) ─────────────────────────────────────────────────────
local skills = {}
for _, module in ipairs(script.Parent:GetChildren()) do
	if module:IsA("ModuleScript") and module.Name ~= "ui_manager" then
		local ok, result = pcall(require, module)
		if ok then
			skills[module.Name] = result
		else
			warn("[NVStudio] Gagal load module '" .. module.Name .. "': " .. tostring(result))
		end
	end
end

-- ── Inisialisasi UI ──────────────────────────────────────────────────────────
if uiModule then
	local UIManager = require(uiModule)
	ui = UIManager.init(plugin, STUDIO_ID)

	ui:setAutoConnectState(true)
	ui:setStatus("waiting")

	if ui.widget then
		toggleBtn:SetActive(ui.widget.Enabled)
		ui.widget:GetPropertyChangedSignal("Enabled"):Connect(function()
			toggleBtn:SetActive(ui.widget.Enabled)
		end)
	end

	toggleBtn.Click:Connect(function()
		ui:toggleVisibility()
	end)

	-- Tombol Connect / Disconnect
	ui.connectBtn.MouseButton1Click:Connect(function()
		if isClickDebounce then return end
		isClickDebounce = true

		if not isRunning then
			isManualDisconnect = false
			reconnectDelay = RECONNECT_DELAY_INITIAL
			ui:setStatus("waiting")
			ui:addLog("[System] Menghubungkan ulang ke Server MCP...", Color3.fromRGB(255, 220, 100))
			task.spawn(startConnectionManager)
		else
			isManualDisconnect = true
			isRunning = false
			serverReachable = false
			mcpAgentActive = false
			if activeWsWrapper then
				activeWsWrapper:Close()
				activeWsWrapper = nil
			end
			currentTransport = "none"
			ui:setStatus("disconnected")
			ui:addLog("[System] Koneksi dihentikan oleh pengguna.", Color3.fromRGB(255, 100, 100))
		end

		task.delay(0.3, function() isClickDebounce = false end)
	end)
else
	toggleBtn.Click:Connect(function()
		print("[NVStudio MCP] ERROR: Modul 'ui_manager' tidak ditemukan. GUI gagal dimuat!")
	end)
end

-- ── Log Capture ──────────────────────────────────────────────────────────────
local function addSystemLog(msg, msgType)
	local color  = Color3.fromRGB(200, 200, 200)
	local prefix = "[INFO] "
	if msgType == Enum.MessageType.MessageError then
		prefix = "[ERROR] "; color = Color3.fromRGB(255, 100, 100)
	elseif msgType == Enum.MessageType.MessageWarning then
		prefix = "[WARN] ";  color = Color3.fromRGB(255, 200, 100)
	end
	local fullMsg = prefix .. msg
	table.insert(ctx.recentLogs, fullMsg)
	if #ctx.recentLogs > MAX_LOGS then table.remove(ctx.recentLogs, 1) end
	if ui then pcall(function() ui:addLog(fullMsg, color) end) end
end
LogService.MessageOut:Connect(addSystemLog)

-- ── Helper: Resolve path ke Instance ─────────────────────────────────────────
local function getInstanceFromPath(pathString)
	if type(pathString) ~= "string" or pathString == "" then return nil end
	local parts   = string.split(pathString, ".")
	if #parts == 0 then return nil end
	local current = game
	if parts[1] == "game" then table.remove(parts, 1) end
	pcall(function()
		local svc = game:GetService(parts[1])
		if svc then current = svc; table.remove(parts, 1) end
	end)
	local i = 1
	while i <= #parts do
		local part = parts[i]
		local found = current:FindFirstChild(part)
		
		-- Jika tidak ketemu, coba gabungkan dengan part berikutnya (untuk nama yang mengandung titik)
		local combinedPart = part
		local lookAhead = i + 1
		while not found and lookAhead <= #parts do
			combinedPart = combinedPart .. "." .. parts[lookAhead]
			found = current:FindFirstChild(combinedPart)
			if found then
				i = lookAhead
			end
			lookAhead = lookAhead + 1
		end
		
		if not found then return nil end
		current = found
		i = i + 1
	end
	return current
end

ctx.getInstanceFromPath = getInstanceFromPath

-- ── Proses Task dari Server ───────────────────────────────────────────────────
local function processTask(taskData)
	if not taskData or not taskData.id or not taskData.command then return nil end

	if ui then
		ui:addLog("[AI Command] " .. taskData.command, Color3.fromRGB(150, 200, 255))
	end

	local targetInstance = getInstanceFromPath(taskData.target)
	if not targetInstance then
		if taskData.target == "" or taskData.target == "nil" then
			targetInstance = game
		else
			return { id = taskData.id, status = "error", error = "Target path tidak ditemukan: " .. tostring(taskData.target) }
		end
	end

	local skillFunc = skills[taskData.command]
	if not skillFunc then
		return { id = taskData.id, status = "error", error = "Command tidak dikenali: " .. taskData.command }
	end

	local ok, result = pcall(function()
		return skillFunc(targetInstance, taskData.data, ctx, taskData.target)
	end)
	
	if not ok then
		result = { status = "error", error = "Internal Plugin Error: " .. tostring(result) }
	end
	
	result = result or { status = "success", result = "Eksekusi selesai (Tidak ada return value)" }
	result.id = taskData.id

	if ui then
		pcall(function()
			local color = result.status == "success" and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
			local summary = tostring(result.result or result.error or "")
			if #summary > 500 then
				summary = string.sub(summary, 1, 500) .. " ... [Output besar]"
			end
			ui:addLog("[AI Result] " .. summary, color)
		end)
	end

	return result
end

-- ── Helper: Sanitize result sebelum JSONEncode (Bug H) ─────────────────────────
local function sanitizeForJson(val, depth)
	depth = depth or 0
	if depth > 5 then return tostring(val) end
	local t = typeof(val)
	if t == "string" or t == "number" or t == "boolean" then
		return val
	elseif t == "Instance" then
		return val:GetFullName()
	elseif t == "Vector3" then
		return { X = val.X, Y = val.Y, Z = val.Z }
	elseif t == "CFrame" then
		return { Position = { X = val.Position.X, Y = val.Position.Y, Z = val.Position.Z } }
	elseif t == "Color3" then
		return { R = val.R, G = val.G, B = val.B }
	elseif t == "table" then
		local sanitized = {}
		for k, v in pairs(val) do
			sanitized[tostring(k)] = sanitizeForJson(v, depth + 1)
		end
		return sanitized
	else
		return tostring(val)
	end
end

-- ── Kirim Respons ke Server (HTTP Fallback) (Bug H) ───────────────────────────
local function sendResponse(taskId, resultData, attempt)
	task.spawn(function()
		local payload = {
			id      = taskId,
			taskId  = taskId,
			attempt = attempt,
			status  = resultData.status or "success",
			result  = sanitizeForJson(resultData.result),
			error   = resultData.error and tostring(resultData.error) or nil,
		}

		local encOk, json = pcall(function()
			return HttpService:JSONEncode(payload)
		end)

		if not encOk then
			payload.result = tostring(payload.result)
			pcall(function() json = HttpService:JSONEncode(payload) end)
		end

		if not json then
			json = string.format('{"id":"%s","taskId":"%s","status":"error","error":"Gagal encode payload JSON"}', taskId, taskId)
		end

		local postOk = pcall(function()
			HttpService:PostAsync(
				RESPONSE_URL .. "/" .. taskId,
				json,
				Enum.HttpContentType.ApplicationJson
			)
		end)

		if not postOk then
			-- Backoff sejenak sebelum fallback ke endpoint legacy (Bug H)
			task.wait(0.2)
			local fallbackOk = pcall(function()
				HttpService:PostAsync(RESPONSE_URL, json, Enum.HttpContentType.ApplicationJson)
			end)
			if not fallbackOk and ui then
				ui:addLog("[System] Gagal kirim response HTTP ke server: " .. tostring(taskId), Color3.fromRGB(255, 100, 100))
			end
		end
	end)
end

-- ── WebSocket API Abstraction ────────────────────────────────────────────────
local function detectWebSocketCapability()
	-- 1. Check HttpService:CreateWebStreamClient (Roblox Studio native API)
	local hasWebStream = false
	pcall(function()
		hasWebStream = (typeof(HttpService.CreateWebStreamClient) == "function")
			and (Enum.WebStreamClientType and Enum.WebStreamClientType.WebSocket ~= nil)
	end)
	if hasWebStream then
		return "WebStreamClient"
	end

	-- 2. Check global WebSocket API jika tersedia
	local wsGlobal = rawget(_G, "WebSocket") or rawget(_G, "websocket")
	if not wsGlobal then
		pcall(function() wsGlobal = WebSocket end)
	end
	if wsGlobal and typeof(wsGlobal.connect) == "function" then
		return "WebSocketGlobal"
	end

	return nil
end

local function createWsClient(url)
	local cap = detectWebSocketCapability()
	if not cap then
		return nil, "WebSocket API not available"
	end

	if cap == "WebStreamClient" then
		local ok, client = pcall(function()
			return HttpService:CreateWebStreamClient(Enum.WebStreamClientType.WebSocket, {
				Url = url
			})
		end)
		if not ok or not client then
			return nil, tostring(client or "CreateWebStreamClient failed")
		end

		local wrapper = {
			raw = client,
			cap = "WebStreamClient",
			closed = false,
			connections = {},
		}

		function wrapper:Send(data)
			if self.closed then return false, "Closed" end
			return pcall(function()
				self.raw:Send(data)
			end)
		end

		function wrapper:Close()
			if self.closed then return end
			self.closed = true
			pcall(function() self.raw:Close() end)
			for _, conn in ipairs(self.connections) do
				pcall(function() conn:Disconnect() end)
			end
			table.clear(self.connections)
		end

		function wrapper:BindEvents(onMessage, onClose)
			if self.raw.MessageReceived and typeof(self.raw.MessageReceived.Connect) == "function" then
				local ok, conn = pcall(function()
					return self.raw.MessageReceived:Connect(onMessage)
				end)
				if ok and conn then table.insert(self.connections, conn) end
			end

			if self.raw.Closed and typeof(self.raw.Closed.Connect) == "function" then
				local ok, conn = pcall(function()
					return self.raw.Closed:Connect(onClose)
				end)
				if ok and conn then table.insert(self.connections, conn) end
			end
		end

		return wrapper, nil

	elseif cap == "WebSocketGlobal" then
		local wsGlobal = rawget(_G, "WebSocket") or rawget(_G, "websocket") or WebSocket
		local ok, client = pcall(function()
			return wsGlobal.connect(url)
		end)
		if not ok or not client then
			return nil, tostring(client or "WebSocket.connect failed")
		end

		local wrapper = {
			raw = client,
			cap = "WebSocketGlobal",
			closed = false,
			connections = {},
		}

		function wrapper:Send(data)
			if self.closed then return false, "Closed" end
			return pcall(function()
				if typeof(self.raw.Send) == "function" then
					self.raw:Send(data)
				elseif typeof(self.raw.send) == "function" then
					self.raw:send(data)
				end
			end)
		end

		function wrapper:Close()
			if self.closed then return end
			self.closed = true
			pcall(function()
				if typeof(self.raw.Close) == "function" then
					self.raw:Close()
				elseif typeof(self.raw.close) == "function" then
					self.raw:close()
				end
			end)
			for _, conn in ipairs(self.connections) do
				pcall(function() conn:Disconnect() end)
			end
			table.clear(self.connections)
		end

		function wrapper:BindEvents(onMessage, onClose)
			if self.raw.MessageReceived and typeof(self.raw.MessageReceived.Connect) == "function" then
				local ok, conn = pcall(function() return self.raw.MessageReceived:Connect(onMessage) end)
				if ok and conn then table.insert(self.connections, conn) end
			elseif self.raw.OnMessage then
				if typeof(self.raw.OnMessage) == "RBXScriptSignal" or (typeof(self.raw.OnMessage) == "userdata" and self.raw.OnMessage.Connect) then
					local ok, conn = pcall(function() return self.raw.OnMessage:Connect(onMessage) end)
					if ok and conn then table.insert(self.connections, conn) end
				else
					pcall(function() self.raw.OnMessage = onMessage end)
				end
			end

			if self.raw.Closed and typeof(self.raw.Closed.Connect) == "function" then
				local ok, conn = pcall(function() return self.raw.Closed:Connect(onClose) end)
				if ok and conn then table.insert(self.connections, conn) end
			elseif self.raw.OnClose then
				if typeof(self.raw.OnClose) == "RBXScriptSignal" or (typeof(self.raw.OnClose) == "userdata" and self.raw.OnClose.Connect) then
					local ok, conn = pcall(function() return self.raw.OnClose:Connect(onClose) end)
					if ok and conn then table.insert(self.connections, conn) end
				else
					pcall(function() self.raw.OnClose = onClose end)
				end
			end
		end

		return wrapper, nil
	end

	return nil, "Unsupported"
end

-- ── WebSocket Message Dispatcher ─────────────────────────────────────────────
local function handleWsMessage(wrapper, rawMessage)
	if type(rawMessage) ~= "string" or rawMessage == "" then return end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(rawMessage) end)
	if not ok or type(decoded) ~= "table" then return end

	local kind = decoded.kind

	-- Heartbeat ping -> balas pong
	if kind == "ping" then
		pcall(function()
			wrapper:Send(HttpService:JSONEncode({ kind = "pong", ts = os.time() }))
		end)
		return
	end

	if kind == "pong" then
		return
	end

	-- Update status koneksi MCP / Studio
	if kind == "status" then
		local newActive = decoded.mcpConnected == true
		local changed = (mcpAgentActive ~= newActive)
		mcpAgentActive = newActive
		if ui then
			if mcpAgentActive then
				ui:setStatus("connected")
			else
				ui:setStatus("server_connected")
			end
			if newActive and changed then
				ui:addLog("[System] ✅ IDE Agent (Antigravity) aktif ⚡", Color3.fromRGB(100, 255, 100))
			elseif not newActive and changed then
				ui:addLog("[System] ⚠️ IDE Agent terputus.", Color3.fromRGB(255, 150, 50))
			end
		end
		return
	end

	-- Eksekusi perintah AI
	if kind == "request" then
		local taskId  = decoded.taskId or decoded.requestId
		local attempt = decoded.attempt
		local command = decoded.command
		local target  = decoded.target
		local data    = decoded.data

		if not taskId or not command then return end
		if not shouldProcessTask(taskId) then return end -- Bug G: Dedup!

		task.spawn(function()
			local resultData = processTask({
				id      = taskId,
				command = command,
				target  = target or "",
				data    = data,
			})
			markTaskDone(taskId) -- Bug G: Tandai selesai
			if resultData then
				-- Push respons instan kembali via WebSocket (Zero-Delay)
				local responseEnvelope = {
					kind    = "response",
					taskId  = taskId,
					id      = taskId,
					attempt = attempt,
					status  = resultData.status,
					result  = sanitizeForJson(resultData.result),
					error   = resultData.error and tostring(resultData.error) or nil,
				}
				local encOk, encoded = pcall(function()
					return HttpService:JSONEncode(responseEnvelope)
				end)
				local sent = false
				if encOk then
					local sendOk, _ = wrapper:Send(encoded)
					sent = (sendOk == true)
				end
				if not sent then
					-- Jika serialisasi atau pengiriman via WS gagal, fallback ke HTTP POST
					sendResponse(taskId, resultData, attempt)
				end
			end
		end)
		return
	end
end

-- ── Proses satu event dari SSE stream (Long-Polling fallback) ────────────────
local function handleSSELine(line)
	local payload = line
	if line:sub(1, 6) == "event:" then return end
	if line:sub(1, 5) == "data:" then
		payload = line:sub(6):gsub("^%s+", ""):gsub("%s+$", "")
	end
	if payload == "" then return end

	local ok, decoded = pcall(function() return HttpService:JSONDecode(payload) end)
	if not ok or type(decoded) ~= "table" then return end

	local kind = decoded.kind

	if kind == "heartbeat" then
		return
	end

	if kind == "status" then
		local newActive = decoded.mcpConnected == true
		local changed = (mcpAgentActive ~= newActive)
		mcpAgentActive = newActive
		if ui then
			if mcpAgentActive then
				ui:setStatus("connected")
			else
				ui:setStatus("server_connected")
			end
			
			if newActive and changed then
				ui:addLog("[System] ✅ IDE Agent (Antigravity) aktif.", Color3.fromRGB(100, 255, 100))
			elseif not newActive and changed then
				ui:addLog("[System] ⚠️ IDE Agent terputus.", Color3.fromRGB(255, 150, 50))
			end
		end
		return
	end

	if kind == "request" then
		local taskId  = decoded.requestId or decoded.taskId
		local attempt = decoded.attempt
		local command = decoded.command
		local target  = decoded.target
		local data    = decoded.data

		if not taskId or not command then return end
		if not shouldProcessTask(taskId) then return end -- Bug G: Dedup!

		task.spawn(function()
			local resultData = processTask({
				id      = taskId,
				command = command,
				target  = target or "",
				data    = data,
			})
			markTaskDone(taskId) -- Bug G: Tandai selesai
			if resultData then
				sendResponse(taskId, resultData, attempt)
			end
		end)
		return
	end
end

-- ── Fallback Loop: Long-Polling (/api/stream) ─────────────────────────────────
function startLongPollingLoop()
	if not isRunning or isManualDisconnect then return end
	currentTransport = "longpoll"
	reconnectDelay = RECONNECT_DELAY_INITIAL

	local loopId = HttpService:GenerateGUID(false)
	currentLoopId = loopId

	if ui then
		ui:addLog("[System] Mode Long-Polling aktif (Port 3055)...", Color3.fromRGB(200, 200, 200))
	end

	local consecutiveErrors = 0

	while isRunning and not isManualDisconnect and currentLoopId == loopId and currentTransport == "longpoll" do
		local streamOk, streamRaw = pcall(function()
			return HttpService:GetAsync(
				STREAM_URL .. "?studioId=" .. HttpService:UrlEncode(STUDIO_ID) .. "&placeId=" .. tostring(game.PlaceId),
				false
			)
		end)

		if streamOk and streamRaw and streamRaw ~= "" then
			consecutiveErrors = 0
			reconnectDelay = RECONNECT_DELAY_INITIAL

			if not serverReachable then
				serverReachable = true
				if ui then
					ui:setStatus(mcpAgentActive and "connected" or "server_connected")
					ui:addLog("[System] ✅ Server MCP terhubung via Long-Polling.", Color3.fromRGB(100, 255, 150))
				end
			end

			for line in (streamRaw .. "\n"):gmatch("([^\n]*)\n") do
				line = line:gsub("\r", "")
				if line ~= "" then
					handleSSELine(line)
				end
			end
			task.wait()
		else
			consecutiveErrors = consecutiveErrors + 1
			if consecutiveErrors >= 2 then
				if serverReachable then
					serverReachable = false
					mcpAgentActive = false
					if ui then
						ui:setStatus("waiting")
						ui:addLog("[System] ⚠️ Server MCP tidak dapat dijangkau. Menghubungkan ulang...", Color3.fromRGB(255, 150, 50))
					end
				end
			end

			task.wait(reconnectDelay)
			reconnectDelay = RECONNECT_DELAY_MAX
		end
	end

	if currentTransport == "longpoll" and (not isRunning or isManualDisconnect) then
		isRunning = false
		serverReachable = false
		mcpAgentActive  = false
		if ui then ui:setStatus("disconnected") end
	end
end

-- ── Connection Manager: WebSocket Utama + Fallback Long-Polling ──────────────
function startConnectionManager()
	if isRunning then return end
	isRunning = true
	isManualDisconnect = false

	local cap = detectWebSocketCapability()
	if cap then
		task.spawn(function()
			local wsFailures = 0
			local backoff = 0.5

			while isRunning and not isManualDisconnect and wsFailures < 3 do
				currentTransport = "websocket"
				if ui then
					ui:setStatus("waiting")
					ui:addLog("[System] Menghubungkan via WebSocket (Port 3055)...", Color3.fromRGB(200, 200, 255))
				end

				local wrapper, err = createWsClient(WS_URL)
				if not wrapper then
					-- Coba fallback ke IP 127.0.0.1
					wrapper, err = createWsClient(WS_URL_IP)
				end

				if wrapper then
					activeWsWrapper = wrapper
					serverReachable = true
					if ui then
						ui:setStatus(mcpAgentActive and "connected" or "server_connected")
						ui:addLog("[System] ⚡ WebSocket Terhubung! (Ultra Low-Latency <1ms)", Color3.fromRGB(100, 255, 150))
					end

					-- Kirim pesan registrasi awal
					local regOk = wrapper:Send(HttpService:JSONEncode({
						kind = "register",
						studioId = STUDIO_ID,
						placeId = game.PlaceId,
						pluginsVersion = 2,
					}))

					if regOk then
						wsFailures = 0
						backoff = 0.5

						local closedSignal = Instance.new("BindableEvent")
						wrapper:BindEvents(
							function(msg)
								handleWsMessage(wrapper, msg)
							end,
							function()
								closedSignal:Fire()
							end
						)

						closedSignal.Event:Wait()
						closedSignal:Destroy()
					end

					if activeWsWrapper == wrapper then
						activeWsWrapper = nil
					end
					wrapper:Close()
				end

				if isManualDisconnect or not isRunning then break end

				wsFailures = wsFailures + 1
				if wsFailures < 3 then
					if ui then
						ui:setStatus("waiting")
						ui:addLog("[System] ⚠️ WebSocket terputus. Reconnect dalam " .. string.format("%.1f", backoff) .. "s...", Color3.fromRGB(255, 180, 50))
					end
					task.wait(backoff)
					backoff = math.min(backoff * 2, 5.0)
				end
			end

			-- Jika WS gagal 3x berturut-turut dan plugin masih aktif -> Beralih ke Long-Polling!
			if isRunning and not isManualDisconnect then
				if ui then
					ui:addLog("[System] ℹ️ Mengalihkan ke Mode Fallback Long-Polling...", Color3.fromRGB(255, 200, 100))
				end
				startLongPollingLoop()
			end
		end)
	else
		-- WebSocket tidak didukung di environment Studio ini -> langsung Long-Polling
		if ui then
			ui:addLog("[System] ℹ️ WebSocket tidak terdeteksi. Menggunakan Long-Polling.", Color3.fromRGB(200, 200, 200))
		end
		startLongPollingLoop()
	end
end

-- ── Plugin Unloading ──────────────────────────────────────────────────────────
plugin.Unloading:Connect(function()
	isManualDisconnect = true
	isRunning = false
	if activeWsWrapper then
		activeWsWrapper:Close()
		activeWsWrapper = nil
	end
end)

-- ══════════════════════════════════════════════════════════════════════
-- STARTUP: Langsung mulai connection manager
-- ══════════════════════════════════════════════════════════════════════
task.spawn(function()
	task.wait(0.5) -- Tunggu UI siap
	startConnectionManager()
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_nv_anim_dispatcher">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">nv_anim_dispatcher</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ══════════════════════════════════════════════════════════════════════
-- NVStudio Subsystem: nv_anim_dispatcher
-- Deskripsi: Headless Modular Command Dispatcher untuk Pembuatan Animasi
-- Mengatur inisialisasi rig, analytical IK, generasi keyframe kurva halus,
-- dan ekspor resmi ke KeyframeSequence di Roblox Studio.
-- ══════════════════════════════════════════════════════════════════════

local kinematicsMod = script.Parent:WaitForChild("nv_kinematics")
local Kinematics = require(kinematicsMod)
local curvesMod = script.Parent:WaitForChild("nv_curves")
local Curves = require(curvesMod)
local motionMod = script.Parent:WaitForChild("nv_motion_generator")
local Motion = require(motionMod)

local Dispatcher = {}

-- ── 1. Helper: Temukan Rig dari Instance atau Path ────────────────────────────
function Dispatcher.getRigInfo(targetInstance: Instance?): Kinematics.RigInfo?
	if not targetInstance then return nil end
	local model = targetInstance:IsA("Model") and targetInstance or targetInstance:FindFirstAncestorOfClass("Model")
	if not model then return nil end
	return Kinematics.inspectRig(model)
end

-- ── 2. Buat KeyframeSequence Resmi di Roblox ─────────────────────────────────
function Dispatcher.buildKeyframeSequence(
	rigInfo: Kinematics.RigInfo,
	clipName: string,
	keyframes: { Motion.KeyframeData },
	options: { loop: boolean?, priority: Enum.AnimationPriority? }?
): KeyframeSequence
	local opts = options or {}
	local isR15 = rigInfo.isR15

	local seq = Instance.new("KeyframeSequence")
	seq.Name = clipName
	seq.Loop = opts.loop ~= false
	seq.Priority = opts.priority or Enum.AnimationPriority.Action

	-- Urutkan keyframes berdasarkan waktu
	table.sort(keyframes, function(a, b) return a.time < b.time end)

	for _, kfData in ipairs(keyframes) do
		local kf = Instance.new("Keyframe")
		kf.Time = kfData.time
		kf.Name = string.format("Frame_%.2f", kfData.time)

		-- Root Pose (HumanoidRootPart)
		local rootPose = Instance.new("Pose")
		rootPose.Name = "HumanoidRootPart"
		rootPose.Weight = 1
		rootPose.EasingStyle = Enum.PoseEasingStyle.Cubic
		rootPose.EasingDirection = Enum.PoseEasingDirection.InOut

		local function createPose(name: string, cf: CFrame?, parent: Instance?): Pose
			local p = Instance.new("Pose")
			p.Name = name
			p.Weight = 1
			p.EasingStyle = Enum.PoseEasingStyle.Cubic
			p.EasingDirection = Enum.PoseEasingDirection.InOut
			if cf then p.CFrame = cf end
			if parent then p.Parent = parent end
			return p
		end

		if isR15 then
			-- LowerTorso pose
			local lowerTorsoPose = createPose("LowerTorso", kfData.poses["Root"], nil)

			-- UpperTorso pose
			local upperTorsoPose = createPose("UpperTorso", kfData.poses["Waist"], nil)

			-- Head
			if kfData.poses["Neck"] then
				createPose("Head", kfData.poses["Neck"], upperTorsoPose)
			end

			-- Arms
			for _, side in ipairs({ "Left", "Right" }) do
				local shoulderPose = createPose(side .. "UpperArm", kfData.poses[side .. "Shoulder"], nil)
				local elbowPose = shoulderPose
				if kfData.poses[side .. "Elbow"] then
					elbowPose = createPose(side .. "LowerArm", kfData.poses[side .. "Elbow"], shoulderPose)
				end
				if kfData.poses[side .. "Wrist"] then
					createPose(side .. "Hand", kfData.poses[side .. "Wrist"], elbowPose)
				end
				shoulderPose.Parent = upperTorsoPose
			end

			-- Legs
			for _, side in ipairs({ "Left", "Right" }) do
				local hipPose = createPose(side .. "UpperLeg", kfData.poses[side .. "Hip"], nil)
				local kneePose = hipPose
				if kfData.poses[side .. "Knee"] then
					kneePose = createPose(side .. "LowerLeg", kfData.poses[side .. "Knee"], hipPose)
				end
				if kfData.poses[side .. "Ankle"] then
					createPose(side .. "Foot", kfData.poses[side .. "Ankle"], kneePose)
				end
				hipPose.Parent = lowerTorsoPose
			end

			upperTorsoPose.Parent = lowerTorsoPose
			lowerTorsoPose.Parent = rootPose
		else
			-- R6 Pose Structure
			local torsoPose = createPose("Torso", kfData.poses["RootJoint"], nil)

			if kfData.poses["Neck"] then
				createPose("Head", kfData.poses["Neck"], torsoPose)
			end

			for _, limb in ipairs({ "Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip" }) do
				if kfData.poses[limb] then
					local partName = limb == "Left Shoulder" and "Left Arm"
						or limb == "Right Shoulder" and "Right Arm"
						or limb == "Left Hip" and "Left Leg"
						or "Right Leg"
					createPose(partName, kfData.poses[limb], torsoPose)
				end
			end

			torsoPose.Parent = rootPose
		end

		-- Lampirkan VFX KeyframeMarkers jika ada event di frame ini
		if opts.vfx_events and type(opts.vfx_events) == "table" then
			for _, evt in ipairs(opts.vfx_events) do
				local evtTime = tonumber(evt.time) or 0
				if math.abs(evtTime - kfData.time) <= 0.08 then
					local marker = Instance.new("KeyframeMarker")
					marker.Name = evt.marker_name or "VFX"
					marker.Value = evt.value or evt.action or "Emit"
					marker.Parent = kf
				end
			end
		end

		rootPose.Parent = kf
		kf.Parent = seq
	end

	return seq
end

-- ── 3. Eksekusi Perintah Pembuatan Animasi ────────────────────────────────────
function Dispatcher.createAnimation(
	targetInstance: Instance,
	action: string,
	parameters: { [string]: any }?,
	keyPoses: { any }?
): { [string]: any }
	local rigInfo = Dispatcher.getRigInfo(targetInstance)
	if not rigInfo then
		return { status = "error", error = "Target bukan model karakter rig (R6/R15) yang valid: " .. targetInstance:GetFullName() }
	end

	local params = parameters or {}
	local clipName = params.clipName or (action .. "_" .. (rigInfo.isR15 and "R15" or "R6"))
	local keyframes: { Motion.KeyframeData }

	if action == "walk_cycle" or action == "walk" then
		keyframes = Motion.generateWalkCycle(rigInfo, params)
	elseif action == "melee_slash" or action == "slash" or action == "sword" then
		keyframes = Motion.generateMeleeSlash(rigInfo, params)
	elseif action == "punch" or action == "combat_punch" then
		keyframes = Motion.generatePunch(rigInfo, params)
	elseif action == "idle" or action == "idle_breath" then
		keyframes = Motion.generateIdle(rigInfo, params)
	elseif action == "custom" and keyPoses and #keyPoses > 0 then
		-- Parser custom keyposes dari input agent
		keyframes = {}
		for _, kp in ipairs(keyPoses) do
			local motorCfs: { [string]: CFrame } = {}
			if kp.poses then
				for mName, cVal in pairs(kp.poses) do
					if type(cVal) == "table" and cVal.t == "CFrame" then
						motorCfs[mName] = CFrame.new(table.unpack(cVal.v))
					elseif type(cVal) == "table" and cVal.angles then
						local a = cVal.angles
						motorCfs[mName] = CFrame.Angles(math.rad(a[1] or 0), math.rad(a[2] or 0), math.rad(a[3] or 0))
					end
				end
			end
			table.insert(keyframes, {
				time = tonumber(kp.time) or 0,
				poses = motorCfs
			})
		end
	else
		return {
			status = "error",
			error = "Action tidak dikenal: '" .. tostring(action) .. "'. Pilihan: walk_cycle, melee_slash, punch, idle_breath, custom."
		}
	end

	-- Simpan KeyframeSequence ke AnimSaves pada Rig
	local animSaves = rigInfo.model:FindFirstChild("AnimSaves")
	if not animSaves then
		animSaves = Instance.new("Model")
		animSaves.Name = "AnimSaves"
		animSaves.Parent = rigInfo.model
	end

	local kfSeq = Dispatcher.buildKeyframeSequence(rigInfo, clipName, keyframes, {
		loop = params.loop,
		priority = Enum.AnimationPriority.Action,
		vfx_events = params.vfx_events
	})
	kfSeq.Parent = animSaves

	-- Terapkan pose pertama ke karakter di Studio untuk live feedback
	if keyframes[1] and keyframes[1].poses then
		for mName, cf in pairs(keyframes[1].poses) do
			local m = rigInfo.motors[mName]
			if m then
				pcall(function() m.C0 = cf end)
			end
		end
	end

	return {
		status = "success",
		result = {
			clipName = clipName,
			action = action,
			rigType = rigInfo.isR15 and "R15" or "R6",
			keyframeCount = #keyframes,
			duration = keyframes[#keyframes].time,
			savedPath = kfSeq:GetFullName(),
			message = string.format("Animasi '%s' berhasil dibuat dan disimpan ke '%s'", clipName, kfSeq:GetFullName())
		}
	}
end

return Dispatcher

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_nv_auto_rigger">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">nv_auto_rigger</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ══════════════════════════════════════════════════════════════════════
-- NVStudio Subsystem: nv_auto_rigger
-- Deskripsi: Mesin Auto-Rigging Deterministik & Heuristik Geometris
-- Membangun struktur rig lengkap untuk Avatar R6, R15, Senjata/Prop,
-- dan Assembly Model secara instan dengan zero-dislocation math.
-- ══════════════════════════════════════════════════════════════════════

local jointMathMod = script.Parent:WaitForChild("nv_joint_math")
local JointMath = require(jointMathMod)

local AutoRigger = {}

-- ── Helper: Dapatkan atau buat Motor6D ─────────────────────────────────────────
local function createOrUpdateMotor(name: string, part0: BasePart, part1: BasePart, parent: Instance?): Motor6D
	part1.Anchored = false
	local existing = part0:FindFirstChild(name) or part1:FindFirstChild(name)
	local motor: Motor6D
	if existing and existing:IsA("Motor6D") then
		motor = existing
	else
		motor = Instance.new("Motor6D")
		motor.Name = name
	end

	motor.Part0 = part0
	motor.Part1 = part1
	local c0, c1 = JointMath.computeInitialOffsets(part0, part1)
	motor.C0 = c0
	motor.C1 = c1
	motor.Parent = parent or part0
	return motor
end

-- ── 1. Auto-Rig R6 Avatar ─────────────────────────────────────────────────────
function AutoRigger.rigR6(model: Model): { [string]: any }
	assert(model and model:IsA("Model"), "Target harus berupa Model")

	local parts: { [string]: BasePart } = {}
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			parts[desc.Name] = desc
		end
	end

	local torso = parts["Torso"] or parts["UpperTorso"]
	if not torso then
		return { status = "error", error = "Model tidak memiliki part 'Torso' untuk R6 rig." }
	end

	local rootPart = parts["HumanoidRootPart"]
	if not rootPart then
		-- Buat HumanoidRootPart transparan jika belum ada
		rootPart = Instance.new("Part")
		rootPart.Name = "HumanoidRootPart"
		rootPart.Size = Vector3.new(2, 2, 1)
		rootPart.Transparency = 1
		rootPart.CanCollide = false
		rootPart.CFrame = torso.CFrame
		rootPart.Parent = model
		parts["HumanoidRootPart"] = rootPart
		model.PrimaryPart = rootPart
	end

	local created = {}

	-- 1. RootJoint: HumanoidRootPart -> Torso
	local rootJoint = createOrUpdateMotor("RootJoint", rootPart, torso, rootPart)
	table.insert(created, "RootJoint")

	-- 2. Neck: Torso -> Head
	if parts["Head"] then
		createOrUpdateMotor("Neck", torso, parts["Head"], torso)
		table.insert(created, "Neck")
	end

	-- 3. Shoulders: Torso -> Arms
	local lArm = parts["Left Arm"] or parts["LeftArm"]
	if lArm then
		createOrUpdateMotor("Left Shoulder", torso, lArm, torso)
		table.insert(created, "Left Shoulder")
	end

	local rArm = parts["Right Arm"] or parts["RightArm"]
	if rArm then
		createOrUpdateMotor("Right Shoulder", torso, rArm, torso)
		table.insert(created, "Right Shoulder")
	end

	-- 4. Hips: Torso -> Legs
	local lLeg = parts["Left Leg"] or parts["LeftLeg"]
	if lLeg then
		createOrUpdateMotor("Left Hip", torso, lLeg, torso)
		table.insert(created, "Left Hip")
	end

	local rLeg = parts["Right Leg"] or parts["RightLeg"]
	if rLeg then
		createOrUpdateMotor("Right Hip", torso, rLeg, torso)
		table.insert(created, "Right Hip")
	end

	-- Pastikan Humanoid bertipe R6
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.RigType = Enum.HumanoidRigType.R6
	end

	return {
		status = "success",
		rigType = "R6",
		jointsCreated = #created,
		jointNames = created,
		rootPart = rootPart.Name
	}
end

-- ── 2. Auto-Rig R15 Avatar ────────────────────────────────────────────────────
function AutoRigger.rigR15(model: Model): { [string]: any }
	assert(model and model:IsA("Model"), "Target harus berupa Model")

	local parts: { [string]: BasePart } = {}
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			parts[desc.Name] = desc
		end
	end

	local lowerTorso = parts["LowerTorso"]
	local upperTorso = parts["UpperTorso"]
	if not lowerTorso or not upperTorso then
		return { status = "error", error = "Model tidak memiliki 'LowerTorso' dan 'UpperTorso' untuk R15 rig." }
	end

	local rootPart = parts["HumanoidRootPart"]
	if not rootPart then
		rootPart = Instance.new("Part")
		rootPart.Name = "HumanoidRootPart"
		rootPart.Size = Vector3.new(2, 2, 1)
		rootPart.Transparency = 1
		rootPart.CanCollide = false
		rootPart.CFrame = lowerTorso.CFrame
		rootPart.Parent = model
		parts["HumanoidRootPart"] = rootPart
		model.PrimaryPart = rootPart
	end

	local r15Hierarchy = {
		{ name = "Root", p0 = "HumanoidRootPart", p1 = "LowerTorso" },
		{ name = "Waist", p0 = "LowerTorso", p1 = "UpperTorso" },
		{ name = "Neck", p0 = "UpperTorso", p1 = "Head" },

		-- Left Arm Chain
		{ name = "LeftShoulder", p0 = "UpperTorso", p1 = "LeftUpperArm" },
		{ name = "LeftElbow", p0 = "LeftUpperArm", p1 = "LeftLowerArm" },
		{ name = "LeftWrist", p0 = "LeftLowerArm", p1 = "LeftHand" },

		-- Right Arm Chain
		{ name = "RightShoulder", p0 = "UpperTorso", p1 = "RightUpperArm" },
		{ name = "RightElbow", p0 = "RightUpperArm", p1 = "RightLowerArm" },
		{ name = "RightWrist", p0 = "RightLowerArm", p1 = "RightHand" },

		-- Left Leg Chain
		{ name = "LeftHip", p0 = "LowerTorso", p1 = "LeftUpperLeg" },
		{ name = "LeftKnee", p0 = "LeftUpperLeg", p1 = "LeftLowerLeg" },
		{ name = "LeftAnkle", p0 = "LeftLowerLeg", p1 = "LeftFoot" },

		-- Right Leg Chain
		{ name = "RightHip", p0 = "LowerTorso", p1 = "RightUpperLeg" },
		{ name = "RightKnee", p0 = "RightUpperLeg", p1 = "RightLowerLeg" },
		{ name = "RightAnkle", p0 = "RightLowerLeg", p1 = "RightFoot" }
	}

	local created = {}
	for _, item in ipairs(r15Hierarchy) do
		local p0 = parts[item.p0]
		local p1 = parts[item.p1]
		if p0 and p1 then
			createOrUpdateMotor(item.name, p0, p1, p0)
			table.insert(created, item.name)
		end
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.RigType = Enum.HumanoidRigType.R15
	end

	return {
		status = "success",
		rigType = "R15",
		jointsCreated = #created,
		jointNames = created,
		rootPart = rootPart.Name
	}
end

-- ── 3. Rig Weapon / Tool ke Karakter ──────────────────────────────────────────
function AutoRigger.rigWeapon(characterModel: Model, weaponInstance: Instance, targetLimbName: string?): { [string]: any }
	assert(characterModel and characterModel:IsA("Model"), "Character target harus berupa Model")
	assert(weaponInstance and weaponInstance:IsA("Instance"), "Weapon target tidak valid")

	local parts: { [string]: BasePart } = {}
	for _, desc in ipairs(characterModel:GetDescendants()) do
		if desc:IsA("BasePart") then
			parts[desc.Name] = desc
		end
	end

	local limb = targetLimbName and parts[targetLimbName]
	if not limb then
		limb = parts["RightHand"] or parts["Right Arm"] or parts["RightArm"] or parts["HumanoidRootPart"]
	end
	if not limb then
		return { status = "error", error = "Tidak dapat menemukan anggota tubuh target (RightHand / Right Arm) pada karakter." }
	end

	-- Cari handle pada senjata
	local weaponHandle: BasePart? = nil
	if weaponInstance:IsA("BasePart") then
		weaponHandle = weaponInstance
	elseif weaponInstance:IsA("Model") or weaponInstance:IsA("Tool") then
		weaponHandle = (weaponInstance :: any).PrimaryPart
			or weaponInstance:FindFirstChild("Handle") :: BasePart?
			or weaponInstance:FindFirstChildWhichIsA("BasePart")
	end

	if not weaponHandle then
		return { status = "error", error = "Senjata tidak memiliki BasePart atau Handle." }
	end

	-- 1. Buat Motor6D penaut karakter ke Handle
	local weaponMotor = createOrUpdateMotor("WeaponGrip", limb, weaponHandle, limb)

	-- 2. Las seluruh bagian senjata lain ke Handle
	local weldedCount = 0
	if weaponInstance ~= weaponHandle then
		for _, desc in ipairs(weaponInstance:GetDescendants()) do
			if desc:IsA("BasePart") and desc ~= weaponHandle then
				desc.Anchored = false
				local weld = desc:FindFirstChild("WeldToHandle") or Instance.new("Weld")
				weld.Name = "WeldToHandle"
				weld.Part0 = weaponHandle
				weld.Part1 = desc
				weld.C0 = weaponHandle.CFrame:ToObjectSpace(desc.CFrame)
				weld.C1 = CFrame.identity
				weld.Parent = weaponHandle
				weldedCount += 1
			end
		end
	end

	return {
		status = "success",
		attachedTo = limb.Name,
		handleName = weaponHandle.Name,
		weldedComponents = weldedCount,
		message = string.format("Senjata '%s' berhasil dirig ke '%s' (%d part dilas)", weaponInstance.Name, limb.Name, weldedCount)
	}
end

-- ── 4. Weld Assembly (Props, Armor, Kendaraan) ────────────────────────────────
function AutoRigger.weldAssembly(container: Instance, primaryPart: BasePart?): { [string]: any }
	assert(container and container:IsA("Instance"), "Container tidak valid")

	local rootPart: BasePart? = primaryPart
	if not rootPart and container:IsA("Model") then
		rootPart = container.PrimaryPart
	end

	local allParts: { BasePart } = {}
	for _, desc in ipairs(container:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(allParts, desc)
		end
	end
	if container:IsA("BasePart") then
		table.insert(allParts, container)
	end

	if #allParts == 0 then
		return { status = "error", error = "Tidak ada BasePart di dalam kontainer untuk dilas." }
	end

	-- Jika belum ada rootPart, tentukan berdasarkan volume terbesar
	if not rootPart then
		local maxVol = -1
		for _, p in ipairs(allParts) do
			local vol = p.Size.X * p.Size.Y * p.Size.Z
			if vol > maxVol then
				maxVol = vol
				rootPart = p
			end
		end
	end

	if not rootPart then
		return { status = "error", error = "Gagal menentukan Root Part untuk pengelasan." }
	end

	local weldsCreated = 0
	for _, p in ipairs(allParts) do
		if p ~= rootPart then
			p.Anchored = false
			local w = p:FindFirstChild("AssemblyWeld") or Instance.new("Weld")
			w.Name = "AssemblyWeld"
			w.Part0 = rootPart
			w.Part1 = p
			w.C0 = rootPart.CFrame:ToObjectSpace(p.CFrame)
			w.C1 = CFrame.identity
			w.Parent = rootPart
			weldsCreated += 1
		end
	end

	return {
		status = "success",
		rootPart = rootPart.Name,
		weldsCreated = weldsCreated,
		message = string.format("Berhasil mengelas %d part ke Root '%s'", weldsCreated, rootPart.Name)
	}
end

-- ── 5. Spatial Geometric Limb Analyzer (Heuristik Bounding Box) ───────────────
-- Menganalisis model dengan nama part acak/impor dan mengklasifikasikan anggota tubuh
function AutoRigger.discoverLimbsBySpatialGeometry(model: Model): { [string]: BasePart }
	local parts: { BasePart } = {}
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(parts, desc)
		end
	end

	if #parts == 0 then return {} end

	-- 1. Hitung bounding box pusat model
	local cframe, size = model:GetBoundingBox()
	local center = cframe.Position

	-- 2. Temukan torso (part dengan volume besar di sekitar pusat vertikal)
	local bestTorso: BasePart = parts[1]
	local bestScore = -1e9

	for _, p in ipairs(parts) do
		local vol = p.Size.X * p.Size.Y * p.Size.Z
		local distToCenter = (p.Position - center).Magnitude
		local score = vol / (distToCenter + 1)
		if score > bestScore then
			bestScore = score
			bestTorso = p
		end
	end

	local identified: { [string]: BasePart } = {
		Torso = bestTorso
	}

	local torsoPos = bestTorso.Position

	-- 3. Klasifikasi part lainnya relatif terhadap Torso
	for _, p in ipairs(parts) do
		if p ~= bestTorso then
			local relPos = bestTorso.CFrame:PointToObjectSpace(p.Position)

			if relPos.Y > bestTorso.Size.Y * 0.5 then
				-- Bagian atas -> Head
				if not identified["Head"] or p.Position.Y > identified["Head"].Position.Y then
					identified["Head"] = p
				end
			elseif relPos.Y < -bestTorso.Size.Y * 0.3 then
				-- Bagian bawah -> Legs
				if relPos.X < 0 then
					identified["Left Leg"] = p
				else
					identified["Right Leg"] = p
				end
			else
				-- Bagian samping -> Arms
				if relPos.X < 0 then
					identified["Left Arm"] = p
				else
					identified["Right Arm"] = p
				end
			end
		end
	end

	return identified
end

return AutoRigger

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_nv_curves">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">nv_curves</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- ══════════════════════════════════════════════════════════════════════
-- NVStudio Subsystem: nv_curves
-- Deskripsi: Mesin Kurva Cubic Bezier, Easing Functions & Quaternion SLERP
-- Menghitung interpolasi waktu dan rotasi sendi secara ultra-halus
-- layaknya kurva Graph Editor animator profesional.
-- ══════════════════════════════════════════════════════════════════════

local Curves = {}
local PI = math.pi
local HALF_PI = math.pi * 0.5
local TAU = math.pi * 2
local DEFAULT_OVERSHOOT = 1.70158

-- ── 1. Cubic Bezier Solver ───────────────────────────────────────────────────
function Curves.bezierParameter(alpha: number, x1: number, x2: number): number
	if alpha <= 0 then return 0 end
	if alpha >= 1 then return 1 end

	x1 = math.clamp(x1, 0, 1)
	x2 = math.clamp(x2, 0, 1)

	local lo, hi, u = 0, 1, alpha
	for _ = 1, 32 do
		local v = 1 - u
		local x = 3 * v * v * u * x1 + 3 * v * u * u * x2 + u * u * u
		local delta = x - alpha
		if math.abs(delta) <= 1e-7 then
			break
		end

		if delta < 0 then
			lo = u
		else
			hi = u
		end

		local deriv = 3 * v * v * x1 + 6 * v * u * (x2 - x1) + 3 * u * u * (1 - x2)
		local cand = deriv > 1e-7 and (u - delta / deriv) or -1
		u = (cand > lo and cand < hi) and cand or (lo + hi) * 0.5
	end

	return u
end

function Curves.cubic(a: number, b: number, c: number, d: number, u: number): number
	local v = 1 - u
	return a * (v * v * v) + b * (3 * v * v * u) + c * (3 * v * u * u) + d * (u * u * u)
end

function Curves.bezierAlpha(t: number, x1: number?, y1: number?, x2: number?, y2: number?): number
	if t <= 0 then return 0 end
	if t >= 1 then return 1 end

	local px1 = x1 or 0.42
	local py1 = y1 or 0.0
	local px2 = x2 or 0.58
	local py2 = y2 or 1.0

	local u = Curves.bezierParameter(t, px1, px2)
	return Curves.cubic(0, py1, py2, 1, u)
end

-- ── 2. Standard Easing Functions ─────────────────────────────────────────────
local EasingTable: { [string]: (t: number) -> number } = {
	Linear = function(t) return t end,

	SineIn = function(t) return 1 - math.cos(t * HALF_PI) end,
	SineOut = function(t) return math.sin(t * HALF_PI) end,
	SineInOut = function(t) return -(math.cos(PI * t) - 1) * 0.5 end,

	QuadIn = function(t) return t * t end,
	QuadOut = function(t) return t * (2 - t) end,
	QuadInOut = function(t) return t < 0.5 and (2 * t * t) or (-1 + (4 - 2 * t) * t) end,

	CubicIn = function(t) return t * t * t end,
	CubicOut = function(t) local f = t - 1 return f * f * f + 1 end,
	CubicInOut = function(t) return t < 0.5 and (4 * t * t * t) or ((t - 1) * (2 * t - 2) * (2 * t - 2) + 1) end,

	QuartIn = function(t) return t * t * t * t end,
	QuartOut = function(t) local f = t - 1 return 1 - f * f * f * f end,
	QuartInOut = function(t) local f = t - 1 return t < 0.5 and (8 * t * t * t * t) or (1 - 8 * f * f * f * f) end,

	ExpoIn = function(t) return t == 0 and 0 or math.pow(2, 10 * (t - 1)) end,
	ExpoOut = function(t) return t == 1 and 1 or (1 - math.pow(2, -10 * t)) end,
	ExpoInOut = function(t)
		if t == 0 then return 0 end
		if t == 1 then return 1 end
		if t < 0.5 then return math.pow(2, 20 * t - 10) * 0.5 end
		return (2 - math.pow(2, -20 * t + 10)) * 0.5
	end,

	BackIn = function(t) local s = DEFAULT_OVERSHOOT return t * t * ((s + 1) * t - s) end,
	BackOut = function(t) local s = DEFAULT_OVERSHOOT local f = t - 1 return f * f * ((s + 1) * f + s) + 1 end,
	BackInOut = function(t)
		local s = DEFAULT_OVERSHOOT * 1.525
		local f = t * 2
		if f < 1 then return 0.5 * (f * f * ((s + 1) * f - s)) end
		f = f - 2
		return 0.5 * (f * f * ((s + 1) * f + s) + 2)
	end,

	BounceOut = function(t)
		if t < (1 / 2.75) then
			return 7.5625 * t * t
		elseif t < (2 / 2.75) then
			local f = t - (1.5 / 2.75)
			return 7.5625 * f * f + 0.75
		elseif t < (2.5 / 2.75) then
			local f = t - (2.25 / 2.75)
			return 7.5625 * f * f + 0.9375
		else
			local f = t - (2.625 / 2.75)
			return 7.5625 * f * f + 0.984375
		end
	end,
	BounceIn = function(t)
		local fn = nil
		-- forward declaration
		return 1 - (function(x)
			if x < (1 / 2.75) then return 7.5625 * x * x
			elseif x < (2 / 2.75) then local f = x - (1.5 / 2.75) return 7.5625 * f * f + 0.75
			elseif x < (2.5 / 2.75) then local f = x - (2.25 / 2.75) return 7.5625 * f * f + 0.9375
			else local f = x - (2.625 / 2.75) return 7.5625 * f * f + 0.984375 end
		end)(1 - t)
	end,
	BounceInOut = function(t)
		local bounceOut = function(x: number): number
			if x < (1 / 2.75) then return 7.5625 * x * x
			elseif x < (2 / 2.75) then local f = x - (1.5 / 2.75) return 7.5625 * f * f + 0.75
			elseif x < (2.5 / 2.75) then local f = x - (2.25 / 2.75) return 7.5625 * f * f + 0.9375
			else local f = x - (2.625 / 2.75) return 7.5625 * f * f + 0.984375 end
		end
		if t < 0.5 then
			return (1 - bounceOut(1 - t * 2)) * 0.5
		end
		return bounceOut(t * 2 - 1) * 0.5 + 0.5
	end,

	ElasticOut = function(t)
		if t == 0 then return 0 end
		if t == 1 then return 1 end
		local p = 0.3
		local s = p / 4
		return math.pow(2, -10 * t) * math.sin((t - s) * TAU / p) + 1
	end,
	ElasticIn = function(t)
		if t == 0 then return 0 end
		if t == 1 then return 1 end
		local p = 0.3
		local s = p / 4
		local f = t - 1
		return -(math.pow(2, 10 * f) * math.sin((f - s) * TAU / p))
	end,
	ElasticInOut = function(t)
		if t == 0 then return 0 end
		if t == 1 then return 1 end
		local p = 0.3 * 1.5
		local s = p / 4
		local f = t * 2 - 1
		if f < 0 then
			return -0.5 * (math.pow(2, 10 * f) * math.sin((f - s) * TAU / p))
		end
		return math.pow(2, -10 * f) * math.sin((f - s) * TAU / p) * 0.5 + 1
	end
}

function Curves.evaluate(easingName: string?, t: number): number
	t = math.clamp(t, 0, 1)
	local name = easingName or "QuadInOut"
	local fn = EasingTable[name]
	if fn then
		return fn(t)
	end
	return t
end

-- ── 3. Quaternion SLERP (Spherical Linear Interpolation) ──────────────────────
-- Representasi Quaternion: { x, y, z, w }
type Quat = { x: number, y: number, z: number, w: number }

local function cframeToQuat(cf: CFrame): (Vector3, Quat)
	local _, _, _, m00, m01, m02, m10, m11, m12, m20, m21, m22 = cf:GetComponents()
	local trace = m00 + m11 + m22
	local q: Quat
	if trace > 0 then
		local s = math.sqrt(trace + 1) * 2
		q = { x = (m21 - m12) / s, y = (m02 - m20) / s, z = (m10 - m01) / s, w = 0.25 * s }
	elseif (m00 > m11) and (m00 > m22) then
		local s = math.sqrt(1 + m00 - m11 - m22) * 2
		q = { x = 0.25 * s, y = (m01 + m10) / s, z = (m02 + m20) / s, w = (m21 - m12) / s }
	elseif m11 > m22 then
		local s = math.sqrt(1 + m11 - m00 - m22) * 2
		q = { x = (m01 + m10) / s, y = 0.25 * s, z = (m12 + m21) / s, w = (m02 - m20) / s }
	else
		local s = math.sqrt(1 + m22 - m00 - m11) * 2
		q = { x = (m02 + m20) / s, y = (m12 + m21) / s, z = 0.25 * s, w = (m10 - m01) / s }
	end
	return cf.Position, q
end

local function quatToCFrame(pos: Vector3, q: Quat): CFrame
	local x, y, z, w = q.x, q.y, q.z, q.w
	local xx, yy, zz = x * x, y * y, z * z
	local xy, xz, yz = x * y, x * z, y * z
	local wx, wy, wz = w * x, w * y, w * z

	return CFrame.new(
		pos.X, pos.Y, pos.Z,
		1 - 2 * (yy + zz), 2 * (xy - wz), 2 * (xz + wy),
		2 * (xy + wz), 1 - 2 * (xx + zz), 2 * (yz - wx),
		2 * (xz - wy), 2 * (yz + wx), 1 - 2 * (xx + yy)
	)
end

function Curves.slerp(cfA: CFrame, cfB: CFrame, alpha: number): CFrame
	if alpha <= 0 then return cfA end
	if alpha >= 1 then return cfB end

	local posA, qA = cframeToQuat(cfA)
	local posB, qB = cframeToQuat(cfB)

	local cosHalfTheta = qA.x * qB.x + qA.y * qB.y + qA.z * qB.z + qA.w * qB.w
	if cosHalfTheta < 0 then
		qB = { x = -qB.x, y = -qB.y, z = -qB.z, w = -qB.w }
		cosHalfTheta = -cosHalfTheta
	end

	local qResult: Quat
	if math.abs(cosHalfTheta) >= 1 then
		qResult = qA
	else
		local halfTheta = math.acos(math.clamp(cosHalfTheta, -1, 1))
		local sinHalfTheta = math.sqrt(1 - cosHalfTheta * cosHalfTheta)
		if math.abs(sinHalfTheta) < 1e-4 then
			qResult = {
				x = qA.x * (1 - alpha) + qB.x * alpha,
				y = qA.y * (1 - alpha) + qB.y * alpha,
				z = qA.z * (1 - alpha) + qB.z * alpha,
				w = qA.w * (1 - alpha) + qB.w * alpha,
			}
		else
			local ratioA = math.sin((1 - alpha) * halfTheta) / sinHalfTheta
			local ratioB = math.sin(alpha * halfTheta) / sinHalfTheta
			qResult = {
				x = qA.x * ratioA + qB.x * ratioB,
				y = qA.y * ratioA + qB.y * ratioB,
				z = qA.z * ratioA + qB.z * ratioB,
				w = qA.w * ratioA + qB.w * ratioB,
			}
		end
	end

	local interpPos = posA:Lerp(posB, alpha)
	return quatToCFrame(interpPos, qResult)
end

return Curves

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_nv_joint_math">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">nv_joint_math</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ══════════════════════════════════════════════════════════════════════
-- NVStudio Subsystem: nv_joint_math
-- Deskripsi: Modul Matematika Kinematika Sambungan (Joints) & Transformasi
-- Menyediakan kalkulasi C0/C1 presisi, pemindahan poros tanpa dislokasi,
-- rotasi poros, penyelarasan koordinat, dan pencerminan simetri bilateral.
-- ══════════════════════════════════════════════════════════════════════

local JointMath = {}

local EPSILON = 1e-6

-- ── 1. Hitung Offset Awal C0 & C1 ─────────────────────────────────────────────
-- Menghubungkan Part0 dan Part1 tanpa mengubah posisi relatif fisik saat ini
function JointMath.computeInitialOffsets(part0: BasePart, part1: BasePart): (CFrame, CFrame)
	local c0 = part0.CFrame:ToObjectSpace(part1.CFrame)
	local c1 = CFrame.identity
	return c0, c1
end

-- ── 2. Geser Poros Sendi di Koordinat Dunia (World Delta) ─────────────────────
-- Menggeser titik pivot tanpa mendislokasi posisi part anak di dunia 3D
function JointMath.offsetPivot(joint: JointInstance, deltaWorld: Vector3): boolean
	local part0 = joint.Part0
	local part1 = joint.Part1
	if not part0 or not part1 then return false end

	local origJointWorld = part0.CFrame * joint.C0
	local desiredWorld = origJointWorld + deltaWorld

	local newC0 = part0.CFrame:ToObjectSpace(desiredWorld)
	local diff = joint.C0:ToObjectSpace(newC0)
	local newC1 = joint.C1 * diff

	joint.C0 = newC0
	joint.C1 = newC1
	return true
end

-- ── 3. Tetapkan Posisi Poros ke Titik Dunia Absolut (Set World Position) ──────
-- Memindahkan titik tumpu sendi tepat ke koordinat 3D yang diinginkan
function JointMath.setPivotWorld(joint: JointInstance, targetWorldPos: Vector3): boolean
	local part0 = joint.Part0
	local part1 = joint.Part1
	if not part0 or not part1 then return false end

	local origJointWorld = part0.CFrame * joint.C0
	local targetWorldCF = CFrame.new(targetWorldPos) * origJointWorld.Rotation

	local newC0 = part0.CFrame:ToObjectSpace(targetWorldCF)
	local diff = joint.C0:ToObjectSpace(newC0)
	local newC1 = joint.C1 * diff

	joint.C0 = newC0
	joint.C1 = newC1
	return true
end

-- ── 4. Rotasi Poros Sendi Tanpa Merusak Rig ───────────────────────────────────
-- Memutar orientasi poros sendi sebesar sudut Euler radian
function JointMath.rotatePivot(joint: JointInstance, rotEulerRad: Vector3): boolean
	local part0 = joint.Part0
	local part1 = joint.Part1
	if not part0 or not part1 then return false end

	local rotCF = CFrame.Angles(rotEulerRad.X, rotEulerRad.Y, rotEulerRad.Z)
	joint.C0 = joint.C0 * rotCF
	joint.C1 = joint.C1 * rotCF
	return true
end

-- ── 5. Reset Poros Sendi ke Pusat Part Anak ───────────────────────────────────
-- Mengembalikan poros sendi ke origin geometris Part1
function JointMath.resetPivot(joint: JointInstance): boolean
	local part0 = joint.Part0
	local part1 = joint.Part1
	if not part0 or not part1 then return false end

	joint.C0 = part0.CFrame:ToObjectSpace(part1.CFrame)
	joint.C1 = CFrame.identity
	return true
end

-- ── 6. Selaraskan Orientasi Poros ke Part0 atau Part1 ─────────────────────────
-- Menjaga posisi poros di dunia tetap sama, tetapi rotasinya mengikuti part referensi
function JointMath.alignJoint(joint: JointInstance, alignTo: "Part0" | "Part1"): boolean
	local part0 = joint.Part0
	local part1 = joint.Part1
	if not part0 or not part1 then return false end

	local pivotWorldPos = (part0.CFrame * joint.C0).Position
	local refCF = alignTo == "Part0" and part0.CFrame or part1.CFrame
	local targetWorldCF = CFrame.new(pivotWorldPos) * refCF.Rotation

	local newC0 = part0.CFrame:ToObjectSpace(targetWorldCF)
	local diff = joint.C0:ToObjectSpace(newC0)
	local newC1 = joint.C1 * diff

	joint.C0 = newC0
	joint.C1 = newC1
	return true
end

-- ── 7. Refleksi CFrame Sumbu X Simetris (Bilateral Mirroring) ──────────────────
-- Mencerminkan CFrame melewati bidang sagittal (sumbu X)
function JointMath.mirrorCFrame(cf: CFrame): CFrame
	local x, y, z,
		r00, r01, r02,
		r10, r11, r12,
		r20, r21, r22 = cf:GetComponents()

	-- Refleksi koordinat posisi dan rotasi M_x * R * M_x
	return CFrame.new(
		-x, y, z,
		r00, -r01, -r02,
		-r10, r11, r12,
		-r20, r21, r22
	)
end

-- ── 8. Cerminkan Sendi Bilateral Kiri <-> Kanan ────────────────────────────────
-- Menerapkan C0 dan C1 yang telah dicerminkan dari sumber ke sendi target
function JointMath.mirrorJoint(sourceJoint: JointInstance, targetJoint: JointInstance): boolean
	if not sourceJoint or not targetJoint then return false end
	targetJoint.C0 = JointMath.mirrorCFrame(sourceJoint.C0)
	targetJoint.C1 = JointMath.mirrorCFrame(sourceJoint.C1)
	return true
end

-- ── 9. Dapatkan Posisi Poros di Dunia ─────────────────────────────────────────
function JointMath.getJointWorldPosition(joint: JointInstance): Vector3?
	local part0 = joint.Part0
	if not part0 then return nil end
	return (part0.CFrame * joint.C0).Position
end

return JointMath

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_nv_kinematics">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">nv_kinematics</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ══════════════════════════════════════════════════════════════════════
-- NVStudio Subsystem: nv_kinematics
-- Deskripsi: Mesin Kinematika Analitis 2-Link LimbIK & Abstraksi R6/R15
-- Menyelesaikan posisi siku/lutut menggunakan Hukum Cosinus O(1) tertutup,
-- ekstensi SoftIK anti-hentakan kaku, dan stabilisasi rotasi leher/kaki.
-- ══════════════════════════════════════════════════════════════════════

local Kinematics = {}
local EPSILON = 1e-6

-- ── 1. SoftIK Algorithm ───────────────────────────────────────────────────────
local function softDistance(dist: number, reach: number, softPercent: number?): number
	if dist <= 0 or reach <= 0 then return 0 end
	local pct = math.clamp(softPercent or 90, 0, 100) / 100
	local onset = reach * pct
	if dist <= onset then
		return dist
	end
	local zone = reach - onset
	if zone <= 0 then
		return math.min(dist, reach)
	end
	local x = (dist - onset) / zone
	local eased = x < 1e-4 and (x * (1 - x * 0.5)) or (1 - math.exp(-x))
	return math.min(dist, reach, onset + zone * eased)
end

-- ── 2. Rotation Between Two Vectors ───────────────────────────────────────────
function Kinematics.rotationBetween(from: Vector3, to: Vector3): CFrame
	if from.Magnitude < EPSILON or to.Magnitude < EPSILON then
		return CFrame.identity
	end
	from = from.Unit
	to = to.Unit
	local dot = math.clamp(from:Dot(to), -1, 1)
	local cross = from:Cross(to)
	if cross.Magnitude < EPSILON then
		if dot > 0 then
			return CFrame.identity
		end
		local basis = math.abs(from.X) < 0.8 and Vector3.xAxis or Vector3.yAxis
		return CFrame.fromAxisAngle(from:Cross(basis).Unit, math.pi)
	end
	return CFrame.fromAxisAngle(cross.Unit, math.atan2(cross.Magnitude, dot))
end

-- ── 3. Analytical 2-Bone Limb Solver (Law of Cosines) ─────────────────────────
function Kinematics.solveTwoLink(
	root: Vector3,
	middle: Vector3,
	tip: Vector3,
	goal: Vector3,
	pole: Vector3?,
	softPercent: number?
): (Vector3, Vector3)
	local upperLen = (middle - root).Magnitude
	local lowerLen = (tip - middle).Magnitude
	if upperLen < EPSILON or lowerLen < EPSILON then
		return middle, tip
	end

	local delta = goal - root
	local rawDist = delta.Magnitude
	local dir = rawDist > EPSILON and delta.Unit or (tip - root).Unit
	local reach = upperLen + lowerLen

	-- Soften distance
	local softened = softDistance(rawDist, reach, softPercent or 90)
	local dist = math.clamp(softened, math.max(math.abs(upperLen - lowerLen), EPSILON), reach - 1e-4)

	-- Bend direction towards pole
	local polePos = pole or (middle + Vector3.new(0, 0, -1))
	local bend = polePos - root
	bend = bend - dir * bend:Dot(dir)
	if bend.Magnitude < EPSILON then
		local basis = math.abs(dir.X) < 0.8 and Vector3.xAxis or Vector3.yAxis
		bend = basis - dir * basis:Dot(dir)
	end
	bend = bend.Unit

	-- Law of Cosines: Upper arm projection along direction vector
	local along = (upperLen * upperLen - lowerLen * lowerLen + dist * dist) / (2 * dist)
	local heightSq = upperLen * upperLen - along * along
	local height = math.sqrt(math.max(0, heightSq))

	local solvedMiddle = root + dir * along + bend * height
	local solvedTip = root + dir * dist
	return solvedMiddle, solvedTip
end

-- ── 4. Rig Discovery & Abstraction (R6 & R15) ──────────────────────────────────
export type RigInfo = {
	model: Model,
	isR15: boolean,
	rootPart: BasePart,
	motors: { [string]: Motor6D },
	parts: { [string]: BasePart }
}

function Kinematics.inspectRig(model: Model): RigInfo?
	if not model or not model:IsA("Model") then return nil end
	local rootPart = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not rootPart then
		rootPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	end
	if not rootPart then return nil end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local isR15 = humanoid and (humanoid.RigType == Enum.HumanoidRigType.R15) or false
	if not humanoid then
		isR15 = model:FindFirstChild("UpperTorso") ~= nil
	end

	local motors: { [string]: Motor6D } = {}
	local parts: { [string]: BasePart } = {}

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("Motor6D") then
			motors[desc.Name] = desc
		elseif desc:IsA("BasePart") then
			parts[desc.Name] = desc
		end
	end

	return {
		model = model,
		isR15 = isR15,
		rootPart = rootPart,
		motors = motors,
		parts = parts
	}
end

-- ── 5. Solve Limb IK on R15 / R6 Rig ──────────────────────────────────────────
function Kinematics.solveLimb(
	rigInfo: RigInfo,
	limbName: string, -- "LeftArm" | "RightArm" | "LeftLeg" | "RightLeg"
	targetWorldPos: Vector3,
	poleWorldPos: Vector3?,
	applyToRig: boolean?
): { [string]: CFrame }?
	local m = rigInfo.motors
	local p = rigInfo.parts

	if rigInfo.isR15 then
		local upperMotorName, lowerMotorName, endMotorName
		local upperPartName, lowerPartName, endPartName
		local defaultPoleOffset = Vector3.new(0, 0, -2)

		if limbName == "LeftArm" then
			upperMotorName, lowerMotorName, endMotorName = "LeftShoulder", "LeftElbow", "LeftWrist"
			upperPartName, lowerPartName, endPartName = "LeftUpperArm", "LeftLowerArm", "LeftHand"
			defaultPoleOffset = Vector3.new(-1, 0, -2)
		elseif limbName == "RightArm" then
			upperMotorName, lowerMotorName, endMotorName = "RightShoulder", "RightElbow", "RightWrist"
			upperPartName, lowerPartName, endPartName = "RightUpperArm", "RightLowerArm", "RightHand"
			defaultPoleOffset = Vector3.new(1, 0, -2)
		elseif limbName == "LeftLeg" then
			upperMotorName, lowerMotorName, endMotorName = "LeftHip", "LeftKnee", "LeftAnkle"
			upperPartName, lowerPartName, endPartName = "LeftUpperLeg", "LeftLowerLeg", "LeftFoot"
			defaultPoleOffset = Vector3.new(0, 0, 2)
		elseif limbName == "RightLeg" then
			upperMotorName, lowerMotorName, endMotorName = "RightHip", "RightKnee", "RightAnkle"
			upperPartName, lowerPartName, endPartName = "RightUpperLeg", "RightLowerLeg", "RightFoot"
			defaultPoleOffset = Vector3.new(0, 0, 2)
		else
			return nil
		end

		local upperMotor = m[upperMotorName]
		local lowerMotor = m[lowerMotorName]
		local upperPart = p[upperPartName]
		local lowerPart = p[lowerPartName]
		local endPart = p[endPartName]

		if not upperMotor or not lowerMotor or not upperPart or not lowerPart or not endPart then
			return nil
		end

		local rootPos = upperPart.Position
		local midPos = lowerPart.Position
		local tipPos = endPart.Position
		local pole = poleWorldPos or (midPos + defaultPoleOffset)

		local solvedMid, solvedTip = Kinematics.solveTwoLink(rootPos, midPos, tipPos, targetWorldPos, pole, 90)

		-- Hitung C0 baru untuk upper dan lower
		local upperParentCF = upperMotor.Part0.CFrame
		local upperGoalWorldCF = CFrame.lookAt(rootPos, solvedMid, pole - rootPos)
		local upperC0 = upperParentCF:Inverse() * upperGoalWorldCF * upperMotor.C1

		local lowerParentCF = solvedMid ~= rootPos and CFrame.lookAt(rootPos, solvedMid) or upperPart.CFrame
		local lowerGoalWorldCF = CFrame.lookAt(solvedMid, solvedTip, pole - solvedMid)
		local lowerC0 = lowerParentCF:Inverse() * lowerGoalWorldCF * lowerMotor.C1

		if applyToRig then
			upperMotor.C0 = upperC0
			lowerMotor.C0 = lowerC0
		end

		return {
			[upperMotorName] = upperC0,
			[lowerMotorName] = lowerC0
		}
	else
		-- Mode R6: 1 bone per limb, arahkan ke targetWorldPos
		local motorName, partName
		if limbName == "LeftArm" then motorName, partName = "Left Shoulder", "Left Arm"
		elseif limbName == "RightArm" then motorName, partName = "Right Shoulder", "Right Arm"
		elseif limbName == "LeftLeg" then motorName, partName = "Left Hip", "Left Leg"
		elseif limbName == "RightLeg" then motorName, partName = "Right Hip", "Right Leg"
		else return nil end

		local motor = m[motorName]
		local part = p[partName]
		if not motor or not part or not motor.Part0 then return nil end

		local rootPos = part.Position
		local goalCF = CFrame.lookAt(rootPos, targetWorldPos)
		local c0 = motor.Part0.CFrame:Inverse() * goalCF * motor.C1

		if applyToRig then
			motor.C0 = c0
		end
		return { [motorName] = c0 }
	end
end

-- ── 6. Head Look-At Stabilizer ────────────────────────────────────────────────
function Kinematics.solveLookAt(rigInfo: RigInfo, targetWorldPos: Vector3, applyToRig: boolean?): CFrame?
	local neckMotor = rigInfo.motors["Neck"]
	local headPart = rigInfo.parts["Head"]
	if not neckMotor or not headPart or not neckMotor.Part0 then return nil end

	local headPos = headPart.Position
	local lookDir = (targetWorldPos - headPos).Unit
	local targetWorldCF = CFrame.lookAt(headPos, headPos + lookDir)
	local neckC0 = neckMotor.Part0.CFrame:Inverse() * targetWorldCF * neckMotor.C1

	if applyToRig then
		neckMotor.C0 = neckC0
	end
	return neckC0
end

return Kinematics

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_nv_motion_generator">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">nv_motion_generator</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ══════════════════════════════════════════════════════════════════════
-- NVStudio Subsystem: nv_motion_generator
-- Deskripsi: Generator Gerakan Karakter Alami (Human-like Motion Synthesis)
-- Menghasilkan pose kunci realistis (Anticipation, Follow-through, Easing)
-- untuk berjalan, berlari, tebasan pedang, tinju, idle, dan lompat.
-- ══════════════════════════════════════════════════════════════════════

local curvesMod = script.Parent:WaitForChild("nv_curves")
local Curves = require(curvesMod)
local kinematicsMod = script.Parent:WaitForChild("nv_kinematics")
local Kinematics = require(kinematicsMod)

local MotionGenerator = {}

export type KeyframeData = {
	time: number, -- 0.0 to duration
	poses: { [string]: CFrame } -- motorName -> C0 CFrame
}

-- ── Helper Angles ─────────────────────────────────────────────────────────────
local function anglesDeg(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

-- ── 1. Generator: Walk Cycle ──────────────────────────────────────────────────
function MotionGenerator.generateWalkCycle(rigInfo: Kinematics.RigInfo, options: { [string]: any }?): { KeyframeData }
	local opts = options or {}
	local duration = tonumber(opts.duration) or 1.0
	local intensity = tonumber(opts.intensity) or 1.0
	local isR15 = rigInfo.isR15

	-- Base offsets per motor
	local m = rigInfo.motors
	local defaultC0 = {}
	for name, motor in pairs(m) do
		defaultC0[name] = motor.C0
	end

	local legAngle = 26 * intensity
	local armAngle = 22 * intensity
	local torsoBob = 0.12 * intensity
	local torsoTwist = 6 * intensity

	local kfTimes = { 0.0, 0.25, 0.50, 0.75, 1.0 }
	local keyframes: { KeyframeData } = {}

	for _, tFrac in ipairs(kfTimes) do
		local tSec = tFrac * duration
		local poses: { [string]: CFrame } = {}

		if isR15 then
			local legPhase = math.sin(tFrac * math.pi * 2)
			local armPhase = -legPhase

			-- Torso movement (vertical bounce on each step)
			local bobY = math.abs(math.cos(tFrac * math.pi * 2)) * torsoBob
			local rootC0 = defaultC0["Root"] or CFrame.identity
			poses["Root"] = rootC0 * CFrame.new(0, -bobY, 0) * anglesDeg(4, legPhase * torsoTwist, 0)

			-- Left Leg & Right Leg
			local lHip = defaultC0["LeftHip"] or CFrame.identity
			local rHip = defaultC0["RightHip"] or CFrame.identity
			local lKnee = defaultC0["LeftKnee"] or CFrame.identity
			local rKnee = defaultC0["RightKnee"] or CFrame.identity

			poses["LeftHip"] = lHip * anglesDeg(legPhase * legAngle, 0, 0)
			poses["RightHip"] = rHip * anglesDeg(-legPhase * legAngle, 0, 0)

			-- Knee bends when leg swings back
			local lKneeBend = math.clamp(-legPhase * legAngle * 1.5, 0, 45)
			local rKneeBend = math.clamp(legPhase * legAngle * 1.5, 0, 45)
			poses["LeftKnee"] = lKnee * anglesDeg(lKneeBend, 0, 0)
			poses["RightKnee"] = rKnee * anglesDeg(rKneeBend, 0, 0)

			-- Left Arm & Right Arm (opposite to legs)
			local lShoulder = defaultC0["LeftShoulder"] or CFrame.identity
			local rShoulder = defaultC0["RightShoulder"] or CFrame.identity
			poses["LeftShoulder"] = lShoulder * anglesDeg(armPhase * armAngle, 0, -4)
			poses["RightShoulder"] = rShoulder * anglesDeg(-armPhase * armAngle, 0, 4)
		else
			-- R6 Rig
			local legPhase = math.sin(tFrac * math.pi * 2)
			local armPhase = -legPhase

			local lShoulder = defaultC0["Left Shoulder"] or CFrame.identity
			local rShoulder = defaultC0["Right Shoulder"] or CFrame.identity
			local lHip = defaultC0["Left Hip"] or CFrame.identity
			local rHip = defaultC0["Right Hip"] or CFrame.identity

			poses["Left Shoulder"] = lShoulder * anglesDeg(armPhase * armAngle, 0, 0)
			poses["Right Shoulder"] = rShoulder * anglesDeg(-armPhase * armAngle, 0, 0)
			poses["Left Hip"] = lHip * anglesDeg(legPhase * legAngle, 0, 0)
			poses["Right Hip"] = rHip * anglesDeg(-legPhase * legAngle, 0, 0)
		end

		table.insert(keyframes, { time = tSec, poses = poses })
	end

	return keyframes
end

-- ── 2. Generator: Melee Slash (Combat Attack) ─────────────────────────────────
function MotionGenerator.generateMeleeSlash(rigInfo: Kinematics.RigInfo, options: { [string]: any }?): { KeyframeData }
	local opts = options or {}
	local duration = tonumber(opts.duration) or 0.8
	local isR15 = rigInfo.isR15

	local defaultC0 = {}
	for name, motor in pairs(rigInfo.motors) do
		defaultC0[name] = motor.C0
	end

	-- Keyframes: 0 (Ready), 0.25 (Wind-up Anticipation), 0.50 (Slash Snap), 0.75 (Follow-Through), 1.0 (Recover)
	local points = {
		{
			t = 0.0,
			armRot = anglesDeg(10, 0, 5),
			torsoRot = anglesDeg(0, 0, 0),
			lArmRot = anglesDeg(5, 0, -5)
		},
		{
			t = 0.25, -- Wind-up
			armRot = anglesDeg(-110, -35, 40),
			torsoRot = anglesDeg(-5, -25, 0),
			lArmRot = anglesDeg(20, 15, -15)
		},
		{
			t = 0.50, -- Slash Strike
			armRot = anglesDeg(65, 30, -25),
			torsoRot = anglesDeg(10, 35, 0),
			lArmRot = anglesDeg(-25, -10, -20)
		},
		{
			t = 0.75, -- Follow-through overshoot
			armRot = anglesDeg(75, 40, -30),
			torsoRot = anglesDeg(8, 40, 0),
			lArmRot = anglesDeg(-15, -5, -15)
		},
		{
			t = 1.0, -- Return
			armRot = anglesDeg(10, 0, 5),
			torsoRot = anglesDeg(0, 0, 0),
			lArmRot = anglesDeg(5, 0, -5)
		}
	}

	local keyframes: { KeyframeData } = {}
	for _, pt in ipairs(points) do
		local poses: { [string]: CFrame } = {}
		if isR15 then
			poses["RightShoulder"] = (defaultC0["RightShoulder"] or CFrame.identity) * pt.armRot
			poses["LeftShoulder"] = (defaultC0["LeftShoulder"] or CFrame.identity) * pt.lArmRot
			poses["Waist"] = (defaultC0["Waist"] or CFrame.identity) * pt.torsoRot
		else
			poses["Right Shoulder"] = (defaultC0["Right Shoulder"] or CFrame.identity) * pt.armRot
			poses["Left Shoulder"] = (defaultC0["Left Shoulder"] or CFrame.identity) * pt.lArmRot
			poses["RootJoint"] = (defaultC0["RootJoint"] or CFrame.identity) * pt.torsoRot
		end
		table.insert(keyframes, { time = pt.t * duration, poses = poses })
	end

	return keyframes
end

-- ── 3. Generator: Punch Combo ─────────────────────────────────────────────────
function MotionGenerator.generatePunch(rigInfo: Kinematics.RigInfo, options: { [string]: any }?): { KeyframeData }
	local opts = options or {}
	local duration = tonumber(opts.duration) or 0.6
	local isR15 = rigInfo.isR15

	local defaultC0 = {}
	for name, motor in pairs(rigInfo.motors) do
		defaultC0[name] = motor.C0
	end

	local points = {
		{ t = 0.0, rArm = anglesDeg(0, 0, 0), torso = anglesDeg(0, 0, 0) },
		{ t = 0.2, rArm = anglesDeg(-20, -10, 15), torso = anglesDeg(0, -15, 0) }, -- Coil back
		{ t = 0.45, rArm = anglesDeg(90, 10, -5), torso = anglesDeg(8, 25, 0) },   -- Thrust forward
		{ t = 0.7, rArm = anglesDeg(70, 5, -2), torso = anglesDeg(4, 15, 0) },     -- Recoil
		{ t = 1.0, rArm = anglesDeg(0, 0, 0), torso = anglesDeg(0, 0, 0) }
	}

	local keyframes: { KeyframeData } = {}
	for _, pt in ipairs(points) do
		local poses: { [string]: CFrame } = {}
		if isR15 then
			poses["RightShoulder"] = (defaultC0["RightShoulder"] or CFrame.identity) * pt.rArm
			poses["Waist"] = (defaultC0["Waist"] or CFrame.identity) * pt.torso
		else
			poses["Right Shoulder"] = (defaultC0["Right Shoulder"] or CFrame.identity) * pt.rArm
			poses["RootJoint"] = (defaultC0["RootJoint"] or CFrame.identity) * pt.torso
		end
		table.insert(keyframes, { time = pt.t * duration, poses = poses })
	end

	return keyframes
end

-- ── 4. Generator: Idle Breathing ──────────────────────────────────────────────
function MotionGenerator.generateIdle(rigInfo: Kinematics.RigInfo, options: { [string]: any }?): { KeyframeData }
	local opts = options or {}
	local duration = tonumber(opts.duration) or 2.5
	local isR15 = rigInfo.isR15

	local defaultC0 = {}
	for name, motor in pairs(rigInfo.motors) do
		defaultC0[name] = motor.C0
	end

	local keyframes: { KeyframeData } = {}
	local steps = 8
	for i = 0, steps do
		local frac = i / steps
		local timeSec = frac * duration
		local breathCycle = math.sin(frac * math.pi * 2)

		local poses: { [string]: CFrame } = {}
		if isR15 then
			poses["Root"] = (defaultC0["Root"] or CFrame.identity) * CFrame.new(0, breathCycle * 0.04, 0)
			poses["Waist"] = (defaultC0["Waist"] or CFrame.identity) * anglesDeg(breathCycle * 1.5, 0, 0)
			poses["Neck"] = (defaultC0["Neck"] or CFrame.identity) * anglesDeg(-breathCycle * 1.0, 0, 0)
		else
			poses["RootJoint"] = (defaultC0["RootJoint"] or CFrame.identity) * CFrame.new(0, 0, breathCycle * 0.04)
			poses["Neck"] = (defaultC0["Neck"] or CFrame.identity) * anglesDeg(-breathCycle * 1.2, 0, 0)
		end

		table.insert(keyframes, { time = timeSec, poses = poses })
	end

	return keyframes
end

-- ── 5. Dense Sampler: Interpolasi Keyframes Menggunakan SLERP & Easing ────────
function MotionGenerator.sampleSequence(
	keyframes: { KeyframeData },
	fps: number,
	easing: string?
): { [number]: { [string]: CFrame } }
	if #keyframes == 0 then return {} end
	table.sort(keyframes, function(a, b) return a.time < b.time end)

	local totalDuration = keyframes[#keyframes].time
	local totalFrames = math.max(1, math.floor(totalDuration * fps))
	local sampled: { [number]: { [string]: CFrame } } = {}

	for f = 0, totalFrames do
		local curTime = (f / totalFrames) * totalDuration

		-- Cari segment keyframe [prev, next]
		local kA = keyframes[1]
		local kB = keyframes[#keyframes]
		for i = 1, #keyframes - 1 do
			if curTime >= keyframes[i].time and curTime <= keyframes[i + 1].time then
				kA = keyframes[i]
				kB = keyframes[i + 1]
				break
			end
		end

		local segDuration = kB.time - kA.time
		local rawAlpha = segDuration > 1e-5 and ((curTime - kA.time) / segDuration) or 0
		local curvedAlpha = Curves.evaluate(easing or "QuadInOut", rawAlpha)

		local framePoses: { [string]: CFrame } = {}
		for motorName, cfA in pairs(kA.poses) do
			local cfB = kB.poses[motorName] or cfA
			framePoses[motorName] = Curves.slerp(cfA, cfB, curvedAlpha)
		end

		sampled[f] = framePoses
	end

	return sampled
end

return MotionGenerator

]]></ProtectedString>
